# Public site configuration
# Hosted consultation payment destination. Unverified /ping visits redirect here.
# Payment verification must be connected before enabling this in production.
RAZORPAY_PAYMENT_PAGE_URL=https://pages.razorpay.com/pingfee
NEXT_PUBLIC_SITE_URL=https://vishnoi.doctorsatdoor.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_DAD_REPORT_ANDROID_URL=
NEXT_PUBLIC_DAD_REPORT_IOS_URL=

# Notion enquiry storage (server-only)
# Create an internal Notion integration, share the database with it, and paste its secret below.
NOTION_API_KEY=
NOTION_DATA_SOURCE_ID=8b0d0ef9-eaa7-479a-a6fc-26fed1f0b34a

# Smart India-wide address search and current-location reverse geocoding (server-only)
# Enable Places API (New) and Geocoding API for this key.
GOOGLE_MAPS_API_KEY=
# Optional compatible Nominatim reverse endpoint; defaults to the public OSM endpoint.
REVERSE_GEOCODER_URL=

# Single admin login (server-only)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Use a cryptographically random value of at least 32 characters.
ADMIN_SESSION_SECRET=

# AI voice transcription and bilingual summaries (server-only)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-5.6-luna

# Optional service configuration
PRIVACY_CONTACT_EMAIL=dadclinik@gmail.com

# Required for production anti-bot protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Independent random secret, minimum 32 characters
BOT_SESSION_SECRET=
